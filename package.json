{
  "name": "dsh-req-search",
  "version": "0.2.0",
  "description": "DSH 全局项目研究引擎：挂在 agent/pre-step 公共执行层，任何入口的开发任务都会自动在后台调研同类项目、开源实现、官方文档与已知问题，把结论注入 Agent 上下文；项目研究面板只是它的观察窗口",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "research",
    "search",
    "global",
    "agent-context"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/all.mjs",
    "test:engine": "node test/engine.test.mjs",
    "test:integration": "node test/integration.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
