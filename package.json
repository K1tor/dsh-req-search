{
  "name": "dsh-req-search",
  "version": "0.3.0",
  "description": "DSH 全局需求检索与方案复用：按任务价值和复杂度动态控制搜索深度与可观测预算，把核验后的参考结论注入 Agent 工作流。", 
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "research",
    "search",
    "global",
    "agent-context"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/all.mjs",
    "test:engine": "node test/engine.test.mjs",
    "test:integration": "node test/integration.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
